{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TechSpokes/seo-agent-tools/catalog/schemas/recipe.schema.json",
  "title": "SEO Agent Tools Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "summary",
    "primary_domain",
    "operations",
    "target",
    "required_inputs",
    "evidence_plan",
    "steps",
    "evidence_requirements",
    "stop_conditions",
    "completion_criteria",
    "output_contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "primary_domain": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "string"
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "source",
          "use",
          "steps",
          "scope",
          "completion_without",
          "fallback"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "enum": [
              "client",
              "server",
              "user"
            ]
          },
          "use": {
            "enum": [
              "conditional",
              "fallback",
              "required"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "maximum",
              "guidance"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "maximum": {
                "type": "integer",
                "minimum": 1
              },
              "guidance": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "completion_without": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allowed",
              "limitation"
            ],
            "properties": {
              "allowed": {
                "type": "boolean"
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "use": {
                  "const": "conditional"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "condition": true
              },
              "required": [
                "condition"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "condition"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "required"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "completion_without": {
                  "type": "object",
                  "properties": {
                    "allowed": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_contracts": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "primary"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/v[1-9][0-9]*$"
          },
          "role": {
            "enum": [
              "conditional",
              "primary"
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "conditional"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "condition": true
              },
              "required": [
                "condition"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "condition"
                ]
              }
            }
          }
        ]
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "type": "integer",
          "minimum": 1
        },
        "sample_guidance": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
