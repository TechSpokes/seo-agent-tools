{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TechSpokes/seo-agent-tools/catalog/schemas/content-question-review.v1.schema.json",
  "title": "Content Question Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "subject",
    "reviewed_at",
    "questions",
    "supplemental_questions",
    "human_escalations",
    "completion"
  ],
  "properties": {
    "contract_id": {
      "const": "content-question-review/v1"
    },
    "subject": {
      "type": "object",
      "minProperties": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questionReview"
      }
    },
    "supplemental_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questionReview"
      }
    },
    "human_escalations": {
      "type": "array",
      "items": {
        "$ref": "shared-evidence.schema.json#/$defs/humanEscalation"
      }
    },
    "completion": {
      "$ref": "#/$defs/completion"
    }
  },
  "$defs": {
    "questionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "status",
        "reason",
        "sources"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "answered",
            "partially_answered",
            "not_answered",
            "unable_to_determine"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "shared-evidence.schema.json#/$defs/source"
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partially_answered",
                  "not_answered"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "recommendation": true
            },
            "required": [
              "recommendation"
            ]
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "stop_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "incomplete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "stop_reason": true
            },
            "required": [
              "stop_reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "stop_reason"
              ]
            }
          }
        }
      ]
    }
  }
}
