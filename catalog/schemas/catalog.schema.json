{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TechSpokes/seo-agent-tools/catalog/schemas/catalog.schema.json",
  "title": "SEO Agent Tools Catalog Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "catalog_schema",
    "recipe_schema",
    "supported_recipe_schema_versions",
    "default_discovery_limit",
    "taxonomy",
    "capabilities",
    "result_contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_schema": {
      "const": "catalog/schemas/catalog.schema.json"
    },
    "recipe_schema": {
      "type": "string",
      "pattern": "^catalog/schemas/[a-z0-9.-]+\\.json$"
    },
    "supported_recipe_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "default_discovery_limit": {
      "type": "integer",
      "minimum": 1
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "evidence_units",
        "operations",
        "targets"
      ],
      "properties": {
        "domains": {
          "$ref": "#/$defs/controlled_ids"
        },
        "evidence_units": {
          "$ref": "#/$defs/controlled_ids"
        },
        "operations": {
          "$ref": "#/$defs/controlled_ids"
        },
        "targets": {
          "$ref": "#/$defs/controlled_ids"
        }
      }
    },
    "capabilities": {
      "$ref": "#/$defs/controlled_ids"
    },
    "result_contracts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+/v[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^catalog/schemas/[a-z0-9.-]+\\.schema\\.json$"
      }
    }
  },
  "$defs": {
    "controlled_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
